{
  "manifest_version": 3,
  "name": "YouMemMe",
  "version": "0.01",

  "description": "Organizes and keeps a log of youtube recommendations.",

  "icons": {
    "48": "icons/border-48.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "teamobsidianasterisk@gmail.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youmemme.js"]
    }
  ]
}